{%- liquid
  assign metal = ''
  for option in product.options_with_values
    assign option_name = option.name | downcase
    if option_name == 'metal' or option_name == 'purity'
      assign metal = product.selected_or_first_available_variant.options[forloop.index0] | downcase
    endif
  endfor
-%}
{%- if metal contains 'gold' or metal contains '9k' or metal contains '14k' or metal contains '18k' -%}
  {%- if show_logo -%}<img src="{{ 'velonna-bis-hallmark.svg' | asset_url }}" alt="Bureau of Indian Standards" width="54" height="38" loading="lazy" style="display:block;width:54px;height:38px;object-fit:contain;margin:0 auto 8px">{%- endif -%}
  Hallmarked Gold{%- else -%}925 Sterling Silver{%- endif -%}
