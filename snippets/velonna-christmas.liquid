{% comment %} Two mirrored seasonal compositions frame homepage headings. {% endcomment %}
<style>
  .vl .vl-seasonal-heading {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 36px 240px;
    margin: 0 -4vw 36px;
  }
  .vl .vl-seasonal-heading::before,
  .vl .vl-seasonal-heading::after {
    content: "";
    position: absolute;
    top: 50%;
    width: 220px;
    height: 290px;
    background: url("{{ 'velonna-christmas-watercolor.png' | asset_url }}") center / contain no-repeat;
    transform: translateY(-50%);
    pointer-events: none;
    opacity: .88;
  }
  .vl .vl-seasonal-heading::before {left: 0;}
  .vl .vl-seasonal-heading::after {right: 0; transform: translateY(-50%) scaleX(-1);}
  .vl .vl-seasonal-heading--reindeer::before,
  .vl .vl-seasonal-heading--reindeer::after {
    background-image: url("{{ 'velonna-christmas-reindeer.png' | asset_url }}");
    width: 240px;
    height: 270px;
  }
  @media (max-width: 749px) {
    .vl .vl-seasonal-heading {
      min-height: 180px;
      padding: 24px 82px;
      margin: 0 -4vw 24px;
    }
    .vl .vl-seasonal-heading::before,
    .vl .vl-seasonal-heading::after,
    .vl .vl-seasonal-heading--reindeer::before,
    .vl .vl-seasonal-heading--reindeer::after {
      width: 80px;
      height: 155px;
    }
    .vl .vl-seasonal-heading .vl-types-title {font-size: clamp(23px, 5vw, 32px);}
  }
</style>
