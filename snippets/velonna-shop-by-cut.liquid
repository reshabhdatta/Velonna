<style>
.vl-cut-shop{padding:3rem 5%;background:#faf7f2;text-align:center}
.vl-cut-shop>p{max-width:560px;margin:0 auto 2rem;color:#655d69;font-size:15px;line-height:1.6}
.vl-cut-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:16px;max-width:1350px;margin:auto}
.vl-cut-card{display:flex;align-items:center;flex-direction:column;justify-content:center;gap:12px;padding:22px 10px;background:#f0eaf4;border:1px solid #e6dceb;border-radius:12px;text-decoration:none;color:#33283d}
.vl-cut-card:hover,.vl-cut-card:focus-visible{background:#e8deed;outline:2px solid #b28a46;outline-offset:3px}
.vl-cut-card svg{width:78px;height:78px;color:#92703b}
.vl-cut-card span{font-size:17px;line-height:1.3}
@media(max-width:900px){.vl-cut-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:600px){.vl-cut-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:10px}.vl-cut-card{padding:16px 6px}.vl-cut-card svg{width:58px;height:58px}.vl-cut-card span{font-size:14px}}
</style>
