<style>
.vl-cut-shop{padding:3.5rem 5%;background:#faf7f2;text-align:center}
.vl-cut-shop>p{max-width:560px;margin:0 auto 2rem;color:#655d69;font-size:15px;line-height:1.6}
.vl-cut-grid{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:24px 18px;max-width:1500px;margin:auto}
.vl-cut-card{display:flex;align-items:center;flex-direction:column;gap:14px;text-decoration:none;color:#33283d}
.vl-cut-card img{display:block;width:100%;height:auto;aspect-ratio:1;padding:22px 24px;background:radial-gradient(ellipse at 35% 20%,#fbf8ff 0%,#eee5f5 52%,#e2d5ed 100%);border:1px solid #e8dfef;border-radius:16px}
.vl-cut-card span{font-family:var(--font-heading-family,Georgia,serif);font-size:19px;line-height:1.3}
.vl-cut-card:hover img{background:radial-gradient(ellipse at 35% 20%,#fffaff 0%,#e9ddf2 52%,#d9c8e7 100%)}
.vl-cut-card:focus-visible{outline:2px solid #92703b;outline-offset:6px;border-radius:16px}
@media(max-width:1000px){.vl-cut-grid{grid-template-columns:repeat(4,minmax(0,1fr))}}
@media(max-width:600px){.vl-cut-shop{padding:2.5rem 5%}.vl-cut-grid{grid-template-columns:repeat(3,minmax(0,1fr));gap:20px 10px}.vl-cut-card img{padding:12px 10px;border-radius:12px}.vl-cut-card span{font-size:15px}}
</style>
