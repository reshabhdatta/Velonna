{% comment %}
  Velonna page loader: pulsing logo mark on white.
  Fades dark/light with a gentle bulge while the page loads.
  Hides when the page is ready (min 1.2s so the pulse registers, failsafe 3s).
{% endcomment %}
<div id="velonna-loader" aria-hidden="true">
  <img
    class="velonna-loader__logo"
    src="{{ 'velonna-loader-logo.png' | asset_url }}"
    alt=""
    width="556"
    height="339"
  >
</div>

<style>
  #velonna-loader {
    position: fixed;
    inset: 0;
    z-index: 9999;
    background: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }
  #velonna-loader.is-done {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .velonna-loader__logo {
    width: min(160px, 36vw);
    height: auto;
    animation: velonna-pulse 1.6s ease-in-out infinite;
  }
  @keyframes velonna-pulse {
    0%, 100% { opacity: 1;    transform: scale(1); }
    50%      { opacity: 0.25; transform: scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .velonna-loader__logo { animation: none; }
    #velonna-loader { transition: none; }
  }
</style>

<script>
  (function () {
    var loader = document.getElementById('velonna-loader');
    if (!loader) return;
    var start = Date.now();
    var MIN = 1200;  // let the pulse register
    var MAX = 3000;  // never block longer than this
    var hide = function () {
      var wait = Math.max(0, MIN - (Date.now() - start));
      setTimeout(function () { loader.classList.add('is-done'); }, wait);
    };
    if (document.readyState === 'complete') {
      hide();
    } else {
      window.addEventListener('load', hide);
    }
    setTimeout(hide, MAX); // failsafe
  })();
</script>

<noscript>
  <style>#velonna-loader { display: none; }</style>
</noscript>
