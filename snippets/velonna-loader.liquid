{% comment %}
  Velonna page loader: the diamond mark with a sweeping gold "shine" and a gentle breathe.
  Hides when the page is ready (min 1.1s so the shine registers, failsafe 3s).
{% endcomment %}
{%- assign vl_mark = 'velonna-loader-mark.png' | asset_url -%}
<div id="velonna-loader" aria-hidden="true">
  <div class="velonna-loader__mark">
    <img src="{{ vl_mark }}" alt="" width="150" height="150">
    <span class="velonna-loader__sheen" style="-webkit-mask-image:url('{{ vl_mark }}');mask-image:url('{{ vl_mark }}');"></span>
  </div>
</div>

<style>
  #velonna-loader {
    position: fixed; inset: 0; z-index: 9999;
    background: #faf9f6;
    display: flex; align-items: center; justify-content: center;
    transition: opacity 0.5s ease, visibility 0.5s ease;
  }
  #velonna-loader.is-done { opacity: 0; visibility: hidden; pointer-events: none; }

  .velonna-loader__mark {
    position: relative;
    width: min(150px, 34vw); height: min(150px, 34vw);
    animation: vl-breathe 2.4s ease-in-out infinite;
    filter: drop-shadow(0 6px 22px rgba(160, 130, 60, 0.28));
  }
  .velonna-loader__mark img { width: 100%; height: 100%; display: block; }

  /* Gold light sweeping across the mark, clipped to its shape via the logo as a mask */
  .velonna-loader__sheen {
    position: absolute; inset: 0; pointer-events: none;
    -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat;
    -webkit-mask-position: center; mask-position: center;
    -webkit-mask-size: contain; mask-size: contain;
    background: linear-gradient(115deg,
      transparent 32%,
      rgba(255,255,255,0.15) 44%,
      rgba(255,255,255,0.85) 50%,
      rgba(255,255,255,0.15) 56%,
      transparent 68%);
    background-size: 250% 100%;
    background-repeat: no-repeat;
    mix-blend-mode: screen;
    animation: vl-sheen 2.4s ease-in-out infinite;
  }

  @keyframes vl-sheen {
    0%   { background-position: 210% 0; }
    55%  { background-position: -110% 0; }
    100% { background-position: -110% 0; }
  }
  @keyframes vl-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.05); }
  }
  @media (prefers-reduced-motion: reduce) {
    .velonna-loader__mark { animation: none; }
    .velonna-loader__sheen { animation: none; }
    #velonna-loader { transition: none; }
  }
</style>

<script>
  (function () {
    var loader = document.getElementById('velonna-loader');
    if (!loader) return;
    var start = Date.now(), MIN = 1100, MAX = 3000;
    var hide = function () {
      var wait = Math.max(0, MIN - (Date.now() - start));
      setTimeout(function () { loader.classList.add('is-done'); }, wait);
    };
    if (document.readyState === 'complete') { hide(); }
    else { window.addEventListener('load', hide); }
    setTimeout(hide, MAX); // failsafe
  })();
</script>

<noscript><style>#velonna-loader { display: none; }</style></noscript>
