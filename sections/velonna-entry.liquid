      "default": "For the everyday ritual"
    },
    {
      "type": "text",
      "id": "silver_cta",
      "label": "CTA",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "silver_url",
      "label": "Link",
      "default": "/collections/silver"
    },
    {
      "type": "header",
      "content": "Lab-Grown Diamonds"
    },
    {
      "type": "text",
      "id": "diamond_label",
      "label": "Label",
      "default": "Lab-Grown\nDiamonds"
    },
    {
      "type": "text",
      "id": "diamond_sub",
      "label": "Subline",
      "default": "Light, held forever"
    },
    {
      "type": "text",
      "id": "diamond_cta",
      "label": "CTA",
      "default": "Explore"
    },
    {
      "type": "url",
      "id": "diamond_url",
      "label": "Link",
      "default": "/collections/diamonds"
    },
    {
      "type": "header",
      "content": "Both"
    },
    {
      "type": "text",
      "id": "both_label",
      "label": "Label",
      "default": "The Full\nAtelier"
    },
    {
      "type": "text",
      "id": "both_sub",
      "label": "Subline",
      "default": "Show me everything"
    },
    {
      "type": "text",
      "id": "both_cta",
      "label": "CTA",
      "default": "Enter"
    },
    {
      "type": "url",
      "id": "both_url",
      "label": "Link",
      "default": "/collections/all"
    },
    {
      "type": "header",
      "content": "Skip button"
    },
    {
      "type": "text",
      "id": "skip_label",
      "label": "Skip label",
      "default": "Enter the atelier"
    }
  ],
  "presets": [
    {
      "name": "Entry Overlay"
    }
  ]
}
{% endschema %}
