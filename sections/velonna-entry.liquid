{% comment %} Velonna Entry Overlay — full-screen category selector {% endcomment %}

<div class="vel-entry" id="vel-entry" aria-modal="true" role="dialog" aria-label="Choose your shopping experience">
  <div class="vel-entry__header">
    <p class="vel-entry__eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="vel-entry__headline">{{ section.settings.headline | newline_to_br }}</h2>
  </div>

  <div class="vel-entry__panels">

    <a href="{{ section.settings.silver_url }}" class="vel-entry__panel vel-entry__panel--silver" data-panel="silver">
      <div class="vel-entry__panel-bg"></div>
      <div class="vel-entry__panel-content">
        <span class="vel-entry__panel-category">{{ section.settings.silver_label }}</span>
        <span class="vel-entry__panel-line"></span>
        <span class="vel-entry__panel-sub">{{ section.settings.silver_sub }}</span>
        <span class="vel-entry__panel-cta">{{ section.settings.silver_cta }} &rarr;</span>
      </div>
    </a>

    <a href="{{ section.settings.diamond_url }}" class="vel-entry__panel vel-entry__panel--diamond" data-panel="diamond">
      <div class="vel-entry__panel-bg"></div>
      <div class="vel-entry__panel-content">
        <span class="vel-entry__panel-category">{{ section.settings.diamond_label }}</span>
        <span class="vel-entry__panel-line"></span>
        <span class="vel-entry__panel-sub">{{ section.settings.diamond_sub }}</span>
        <span class="vel-entry__panel-cta">{{ section.settings.diamond_cta }} &rarr;</span>
      </div>
    </a>

    <a href="{{ section.settings.both_url }}" class="vel-entry__panel vel-entry__panel--both" data-panel="both">
      <div class="vel-entry__panel-bg"></div>
      <div class="vel-entry__panel-content">
        <span class="vel-entry__panel-category">{{ section.settings.both_label }}</span>
        <span class="vel-entry__panel-line"></span>
        <span class="vel-entry__panel-sub">{{ section.settings.both_sub }}</span>
        <span class="vel-entry__panel-cta">{{ section.settings.both_cta }} &rarr;</span>
      </div>
    </a>

  </div>

  <button class="vel-entry__skip" id="vel-entry-skip" type="button" aria-label="Skip to homepage">
    {{ section.settings.skip_label }}
    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
      <path d="M8 3v10M3 9l5 5 5-5" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>
</div>

<style>
  :root {
    --vel-entry-silver-from: #f0ece4;
    --vel-entry-silver-to:   #e8e3da;
    --vel-entry-diamond-from: #edeae2;
    --vel-entry-diamond-to:   #e4e0d6;
    --vel-entry-both-from: #f5f2ec;
    --vel-entry-both-to:   #ede9e0;
  }

  .vel-entry {
    position: fixed;
    inset: 0;
    z-index: 9990;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #faf9f6;
    transition: opacity 0.7s cubic-bezier(0.4,0,0.2,1), visibility 0.7s;
    padding: 0;
    overflow: hidden;
  }

  .vel-entry.is-hidden {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* ── Header ── */
  .vel-entry__header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    text-align: center;
    padding: 3rem 2rem 1rem;
    z-index: 10;
    pointer-events: none;
  }

  .vel-entry__eyebrow {
    font-family: 'Neue Haas Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(26,22,18,0.38);
    margin: 0 0 1.25rem;
  }

  .vel-entry__headline {
    font-family: 'Cormorant Garamond', 'Cormorant', Georgia, serif;
    font-size: clamp(2rem, 4vw, 3.25rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.2;
    color: rgba(26,22,18,0.88);
    margin: 0;
    letter-spacing: -0.01em;
  }

  /* ── Panels ── */
  .vel-entry__panels {
    display: flex;
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .vel-entry__panel {
    flex: 1;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    padding: 3.5rem 3rem;
    text-decoration: none;
    overflow: hidden;
    transition: flex 0.55s cubic-bezier(0.4,0,0.2,1);
    cursor: pointer;
  }

  .vel-entry__panels:hover .vel-entry__panel {
    flex: 0.7;
  }

  .vel-entry__panels:hover .vel-entry__panel:hover {
    flex: 1.6;
  }

  /* Panel backgrounds */
  .vel-entry__panel-bg {
    position: absolute;
    inset: 0;
    transition: opacity 0.55s ease;
  }

  .vel-entry__panel--silver .vel-entry__panel-bg {
    background: linear-gradient(160deg, var(--vel-entry-silver-from) 0%, var(--vel-entry-silver-to) 100%);
  }

  .vel-entry__panel--diamond .vel-entry__panel-bg {
    background: linear-gradient(160deg, var(--vel-entry-diamond-from) 0%, var(--vel-entry-diamond-to) 100%);
  }

  .vel-entry__panel--both .vel-entry__panel-bg {
    background: linear-gradient(160deg, var(--vel-entry-both-from) 0%, var(--vel-entry-both-to) 100%);
  }

  /* Dim non-hovered panels */
  .vel-entry__panels:hover .vel-entry__panel:not(:hover) .vel-entry__panel-bg {
    opacity: 0.45;
  }

  /* Thin dividers between panels */
  .vel-entry__panel + .vel-entry__panel::before {
    content: '';
    position: absolute;
    left: 0;
    top: 20%;
    bottom: 20%;
    width: 1px;
    background: rgba(26,22,18,0.1);
    z-index: 1;
  }

  /* Panel accent marks — one tiny horizontal bar per panel personality */
  .vel-entry__panel--silver::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 2.5rem;
    width: 1.5rem;
    height: 1px;
    background: rgba(26,22,18,0.25);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease 0.1s;
  }
  .vel-entry__panel--diamond::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 2.5rem;
    width: 1.5rem;
    height: 1px;
    background: rgba(200,169,110,0.4);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease 0.1s;
  }
  .vel-entry__panel--both::after {
    content: '';
    position: absolute;
    top: 50%;
    right: 2.5rem;
    width: 1.5rem;
    height: 1px;
    background: rgba(26,22,18,0.2);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s ease 0.1s;
  }
  .vel-entry__panel:hover::after {
    transform: scaleX(1);
  }

  /* Panel content */
  .vel-entry__panel-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .vel-entry__panel-category {
    font-family: 'Cormorant Garamond', 'Cormorant', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.75rem);
    font-weight: 300;
    line-height: 1.15;
    letter-spacing: -0.01em;
    display: block;
  }

  .vel-entry__panel--silver .vel-entry__panel-category { color: #3a3530; }
  .vel-entry__panel--diamond .vel-entry__panel-category { color: #c8a96e; }
  .vel-entry__panel--both .vel-entry__panel-category { color: rgba(26,22,18,0.88); }

  .vel-entry__panel-line {
    display: block;
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.25;
  }

  .vel-entry__panel--silver .vel-entry__panel-line { color: #3a3530; }
  .vel-entry__panel--diamond .vel-entry__panel-line { color: #c8a96e; }
  .vel-entry__panel--both .vel-entry__panel-line { color: rgba(26,22,18,0.5); }

  .vel-entry__panel-sub {
    font-family: 'Neue Haas Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    display: block;
    transition: opacity 0.3s ease;
  }

  .vel-entry__panel--silver .vel-entry__panel-sub { color: rgba(58,53,48,0.45); }
  .vel-entry__panel--diamond .vel-entry__panel-sub { color: rgba(200,169,110,0.55); }
  .vel-entry__panel--both .vel-entry__panel-sub { color: rgba(26,22,18,0.35); }

  .vel-entry__panel:hover .vel-entry__panel-sub {
    opacity: 1;
  }

  .vel-entry__panel--silver:hover .vel-entry__panel-sub { color: rgba(58,53,48,0.7); }
  .vel-entry__panel--diamond:hover .vel-entry__panel-sub { color: rgba(200,169,110,0.8); }
  .vel-entry__panel--both:hover .vel-entry__panel-sub { color: rgba(26,22,18,0.6); }

  .vel-entry__panel-cta {
    font-family: 'Neue Haas Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    display: block;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .vel-entry__panel--silver .vel-entry__panel-cta { color: rgba(58,53,48,0.7); }
  .vel-entry__panel--diamond .vel-entry__panel-cta { color: #c8a96e; }
  .vel-entry__panel--both .vel-entry__panel-cta { color: rgba(26,22,18,0.65); }

  .vel-entry__panel:hover .vel-entry__panel-cta {
    opacity: 1;
    transform: translateY(0);
  }

  /* ── Skip button ── */
  .vel-entry__skip {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Neue Haas Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(26,22,18,0.28);
    padding: 0.5rem 1rem;
    transition: color 0.3s ease;
    z-index: 10;
    white-space: nowrap;
  }

  .vel-entry__skip:hover {
    color: rgba(26,22,18,0.55);
  }

  .vel-entry__skip svg {
    animation: vel-bounce 2s ease-in-out infinite;
  }

  @keyframes vel-bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(3px); }
  }

  /* ── Entry animation ── */
  .vel-entry__panel {
    opacity: 0;
    transform: translateY(30px);
    animation: vel-panel-in 0.8s cubic-bezier(0.4,0,0.2,1) forwards;
  }

  .vel-entry__panel:nth-child(1) { animation-delay: 0.1s; }
  .vel-entry__panel:nth-child(2) { animation-delay: 0.2s; }
  .vel-entry__panel:nth-child(3) { animation-delay: 0.3s; }

  .vel-entry__header {
    opacity: 0;
    animation: vel-fade-in 0.6s ease 0.05s forwards;
  }

  .vel-entry__skip {
    opacity: 0;
    animation: vel-fade-in 0.6s ease 0.5s forwards;
  }

  @keyframes vel-panel-in {
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes vel-fade-in {
    to { opacity: 1; }
  }

  /* ── Mobile ── */
  @media (max-width: 680px) {
    .vel-entry__panels {
      flex-direction: column;
    }

    .vel-entry__panels:hover .vel-entry__panel { flex: 0.7; }
    .vel-entry__panels:hover .vel-entry__panel:hover { flex: 1.6; }

    .vel-entry__panel {
      padding: 2rem 1.75rem;
      align-items: flex-start;
      justify-content: flex-end;
    }

    .vel-entry__panel + .vel-entry__panel::before {
      left: 15%;
      right: 15%;
      top: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .vel-entry__panel-category {
      font-size: 1.75rem;
    }

    .vel-entry__headline {
      font-size: 1.5rem;
    }

    .vel-entry__header {
      padding: 1.5rem 1.5rem 0.75rem;
    }

    .vel-entry__panel-cta {
      opacity: 1;
      transform: none;
    }

    .vel-entry__skip {
      bottom: 1.25rem;
    }
  }
</style>

<script>
(function() {
  var KEY = 'vel_entry_seen';
  var overlay = document.getElementById('vel-entry');
  var skipBtn = document.getElementById('vel-entry-skip');

  if (!overlay) return;

  // Hide immediately if seen this session
  if (sessionStorage.getItem(KEY)) {
    overlay.classList.add('is-hidden');
    return;
  }

  function dismiss() {
    sessionStorage.setItem(KEY, '1');
    overlay.classList.add('is-hidden');
  }

  // Skip button — just reveal the editorial page underneath
  if (skipBtn) {
    skipBtn.addEventListener('click', dismiss);
  }

  // Panel links — store choice and let href navigate
  var panels = overlay.querySelectorAll('.vel-entry__panel');
  panels.forEach(function(panel) {
    panel.addEventListener('click', function() {
      sessionStorage.setItem(KEY, '1');
      // natural href navigation proceeds
    });
  });

  // Also allow Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') dismiss();
  });
})();
</script>

{% schema %}
{
  "name": "Entry Overlay",
  "tag": "div",
  "class": "vel-entry-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
