<script>
(function () {
  // Simple fade-in on scroll for editorial elements
  if (!('IntersectionObserver' in window)) return;

  var targets = document.querySelectorAll(
    '.vl-statement-inner, .vl-ed-eyebrow, .vl-ed-title, .vl-ed-body, .vl-ed-link, ' +
    '.vl-feature-content, .vl-enquire-title, .vl-enquire-sub, ' +
    '.vl-products-header, .vl-product-card'
  );

  targets.forEach(function (el) {
    el.style.opacity = '0';
    el.style.transform = 'translateY(24px)';
    el.style.transition = 'opacity 0.8s ease, transform 0.8s ease';
  });

  var io = new IntersectionObserver(function (entries) {
    entries.forEach(function (e) {
      if (e.isIntersecting) {
        e.target.style.opacity = '1';
        e.target.style.transform = 'none';
        io.unobserve(e.target);
      }
    });
  }, { rootMargin: '0px 0px -60px 0px', threshold: 0.1 });

  targets.forEach(function (el) { io.observe(el); });

  // Failsafe: never leave content stuck invisible if the observer doesn't fire (mobile edge cases)
  setTimeout(function () { targets.forEach(function (el) { if (getComputedStyle(el).opacity === '0') { el.style.opacity = '1'; el.style.transform = 'none'; } }); }, 1600);

  // Stagger product cards
  document.querySelectorAll('.vl-product-card').forEach(function (card, i) {
    card.style.transitionDelay = (i * 0.08) + 's';
  });

  // Card stack: fan layout, swipe/drag, dots, gentle auto-advance
  (function () {
    var stage = document.querySelector('.vl-tiles-stage');
    if (!stage) return;
    var cards = [].slice.call(stage.querySelectorAll('.vl-tile'));
    var dots = [].slice.call(document.querySelectorAll('.vl-tiles-dot'));
    var len = cards.length;
    if (len < 2) return;
    var active = 1; // start on Lab Grown Diamonds
    var dragMoved = false;
    var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function offsetOf(i) {
      var raw = i - active;
      var alt = raw > 0 ? raw - len : raw + len;
      return Math.abs(alt) < Math.abs(raw) ? alt : raw;
    }
    function render() {
      cards.forEach(function (c, i) {
        var o = offsetOf(i), a = Math.abs(o);
        c.style.setProperty('--off', o);
        c.style.setProperty('--abs', a);
        c.style.setProperty('--lift', o === 0 ? '20px' : '0px');
        c.style.setProperty('--sc', o === 0 ? '1.03' : '0.92');
        c.classList.toggle('is-active', o === 0);
        c.setAttribute('aria-hidden', o === 0 ? 'false' : 'true');
      });
      dots.forEach(function (d, i) { d.classList.toggle('is-on', i === active); });
    }
    function go(i) { active = ((i % len) + len) % len; render(); }

    cards.forEach(function (c, i) {
      c.addEventListener('click', function (e) {
        if (dragMoved) { e.preventDefault(); return; }
        if (offsetOf(i) !== 0) { e.preventDefault(); go(i); } // side card: focus it
        // active card: link navigates normally
      });
    });
    dots.forEach(function (d, i) { d.addEventListener('click', function () { go(i); }); });

    var startX = null;
    stage.addEventListener('pointerdown', function (e) { startX = e.clientX; dragMoved = false; });
    stage.addEventListener('pointermove', function (e) {
      if (startX !== null && Math.abs(e.clientX - startX) > 12) dragMoved = true;
    });
    stage.addEventListener('pointerup', function (e) {
      if (startX === null) return;
      var dx = e.clientX - startX;
      if (dx > 48) { go(active - 1); } else if (dx < -48) { go(active + 1); }
      startX = null;
      setTimeout(function () { dragMoved = false; }, 60);
    });
    stage.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') go(active - 1);
      if (e.key === 'ArrowRight') go(active + 1);
    });

    var hovering = false;
    stage.addEventListener('mouseenter', function () { hovering = true; });
    stage.addEventListener('mouseleave', function () { hovering = false; });
    if (!reduce) {
      setInterval(function () {
        if (!hovering && document.visibilityState === 'visible') go(active + 1);
      }, 4500);
    }
    render();
  })();

  // Tile video: hover to play on desktop, play-while-in-view on touch devices
  document.querySelectorAll('.vl-tile-video').forEach(function (tv) {
    tv.playbackRate = 0.75; // slow it down
    var tile = tv.closest('.vl-tile') || tv;
    if (window.matchMedia('(hover: hover)').matches) {
      tile.addEventListener('mouseenter', function () { tv.play().catch(function () {}); });
      tile.addEventListener('mouseleave', function () { tv.pause(); });
    } else {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) { tv.play().catch(function () {}); } else { tv.pause(); }
        });
      }, { threshold: 0.35 }).observe(tv);
    }
  });

  // Category videos (Watches, Toys): hover to play on desktop, play-in-view on touch. Never autoplay on desktop.
  document.querySelectorAll('.vl-cat-video').forEach(function (cv) {
    var card = cv.closest('.vl-cat') || cv;
    if (window.matchMedia('(hover: hover)').matches) {
      card.addEventListener('mouseenter', function () { cv.play().catch(function () {}); });
      card.addEventListener('mouseleave', function () { cv.pause(); try { cv.currentTime = 0; } catch (e) {} });
    } else {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { cv.play().catch(function () {}); } else { cv.pause(); } });
      }, { threshold: 0.4 }).observe(cv);
    }
  });

  // Perf: pause background autoplay videos (hero, editorials, enquiry) when off-screen,
  // so phones aren't decoding several clips at once (a big cause of jank/crashes).
  document.querySelectorAll('.vl video[autoplay]').forEach(function (v) {
    new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { v.play().catch(function () {}); } else { v.pause(); }
      });
    }, { threshold: 0.1 }).observe(v);
  });
})();
</script>

