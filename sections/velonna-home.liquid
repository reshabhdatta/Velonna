{% comment %} VELONNA — Cartier-inspired editorial landing {% endcomment %}

<style>
  .vl *, .vl *::before, .vl *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --vl-bg:     #faf9f6;
    --vl-bg-alt: #f0ece4;
    --vl-ink:    #1a1612;
    --vl-gold:   #c8a96e;
    --vl-mid:    rgba(26,22,18,0.55);
    --vl-faint:  rgba(26,22,18,0.3);
    --vl-rule:   rgba(26,22,18,0.1);
  }

  .vl {
    background: var(--vl-bg);
    color: var(--vl-ink);
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 300;
    -webkit-font-smoothing: antialiased;
    overflow-x: hidden;
  }
  .vl a { color: inherit; text-decoration: none; }
  .vl img, .vl video { display: block; max-width: 100%; }

  /* ── HERO ─────────────────────────────────────────────── */
  .vl-hero {
    position: relative;
    height: 100svh; min-height: 560px;
    display: flex; align-items: flex-end;
    overflow: hidden;
    background: #14110e; /* dark base so the hero is always readable, even before/without the video */
  }
  .vl-hero-media {
    position: absolute; top: 0; left: 0; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .vl-hero-overlay {
    position: absolute; top: 0; left: 0; inset: 0;
    width: 100%; height: 100%;
    background-color: rgba(8,8,8,0.48);
    background-image:
      linear-gradient(to right, rgba(8,8,8,0.5) 0%, rgba(8,8,8,0.15) 55%, transparent 100%),
      linear-gradient(to bottom, rgba(8,8,8,0.2) 0%, rgba(8,8,8,0.1) 30%, rgba(8,8,8,0.6) 75%, rgba(8,8,8,0.92) 100%);
  }
  .vl-hero-content {
    position: relative; z-index: 2;
    width: 100%; padding: 0 6vw 8vh;
  }
  .vl-hero-eyebrow {
    font-size: 10px; letter-spacing: 0.32em; text-transform: uppercase;
    color: var(--vl-gold); margin-bottom: 1.5rem;
  }
  .vl-hero-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(40px, 7vw, 96px);
    font-weight: 400; line-height: 0.95;
    letter-spacing: -0.01em;
    max-width: min(900px, 92vw);
    color: #C1933F;
    text-shadow: 0 2px 18px rgba(0,0,0,0.35);
    overflow-wrap: normal;
    word-break: keep-all;
    hyphens: none;
  }
  .vl-hero-title em { font-style: italic; color: #C1933F; }
  .vl-hero-sub {
    margin-top: 2rem;
    font-size: clamp(12px, 1.2vw, 14px);
    letter-spacing: 0.08em;
    color: rgba(245,240,232,0.55);
    max-width: 320px;
    line-height: 1.7;
  }
  .vl-hero-cta {
    display: inline-flex; align-items: center; gap: 10px;
    margin-top: 2.5rem;
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: #faf9f6;
    border-bottom: 1px solid rgba(245,240,232,0.4);
    padding-bottom: 4px;
    transition: border-color 0.25s, gap 0.25s;
  }
  .vl-hero-cta::after { content: '→'; }
  .vl-hero-cta:hover { border-color: var(--vl-gold); gap: 18px; }

  /* ── MARQUEE ──────────────────────────────────────────── */
  .vl-band {
    border-top: 1px solid var(--vl-rule);
    border-bottom: 1px solid var(--vl-rule);
    overflow: hidden; white-space: nowrap;
    background: var(--vl-bg-alt);
  }
  .vl-band-track {
    display: inline-flex;
    animation: vlMarquee 32s linear infinite;
  }
  .vl-band-group { display: inline-flex; align-items: center; padding: 14px 0; }
  .vl-band-item {
    font-size: 10px; letter-spacing: 0.24em; text-transform: uppercase;
    color: var(--vl-faint); padding: 0 28px;
  }
  .vl-band-dot { color: var(--vl-gold); font-size: 14px; line-height: 1; }
  @keyframes vlMarquee { from{transform:translateX(0)} to{transform:translateX(-50%)} }

  /* ── COLLECTION TILES (Cartier-inspired 3-col) ─────────── */
  .vl-tiles {
    background: var(--vl-bg);
    padding: 4.5rem 0 3.5rem;
    overflow: hidden;
  }
  .vl-tiles-stage {
    position: relative;
    height: min(62vh, 600px);
    min-height: 420px;
    perspective: 1200px;
    touch-action: pan-y;
    outline: none;
  }
  .vl-tile {
    position: absolute;
    left: 50%;
    top: 50%;
    height: 92%;
    aspect-ratio: 3/4;
    overflow: hidden;
    cursor: pointer;
    border-radius: 16px;
    box-shadow: 0 30px 60px rgba(26, 22, 18, 0.28);
    transform-style: preserve-3d;
    transform: translate(-50%, -50%)
      translateX(calc(var(--off, 0) * min(300px, 26vw)))
      translateZ(calc(var(--abs, 0) * -150px))
      rotateZ(calc(var(--off, 0) * 8deg))
      translateY(calc(var(--abs, 0) * 16px - var(--lift, 0px)))
      scale(var(--sc, 1));
    z-index: calc(100 - var(--abs, 0));
    transition: transform 0.55s cubic-bezier(0.22, 0.61, 0.36, 1), filter 0.4s ease;
  }
  .vl-tile:not(.is-active) {
    filter: brightness(0.72) saturate(0.85);
  }
  .vl-tile img, .vl-tile video { pointer-events: none; }
  .vl-tiles-dots {
    display: flex;
    justify-content: center;
    gap: 10px;
    margin-top: 2.2rem;
  }
  .vl-tiles-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: rgba(26, 22, 18, 0.22);
    border: none; padding: 0;
    cursor: pointer;
    transition: background 0.25s, transform 0.25s;
  }
  .vl-tiles-dot.is-on {
    background: var(--vl-gold);
    transform: scale(1.3);
  }
  @media (prefers-reduced-motion: reduce) {
    .vl-tile { transition: none; }
  }
  .vl-tile-img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .vl-tile:hover .vl-tile-img { transform: scale(1.06); }
  .vl-tile-overlay {
    position: absolute; inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(8,8,8,0.65) 100%
    );
  }
  .vl-tile-label {
    position: absolute; bottom: 0; left: 0; right: 0;
    padding: 2.5rem 2rem 2rem;
    color: #fff;
  }
  .vl-tile-eyebrow {
    font-size: 9px; letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--vl-gold); margin-bottom: 0.4rem;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s, transform 0.35s;
  }
  .vl-tile:hover .vl-tile-eyebrow { opacity: 1; transform: translateY(0); }
  .vl-tile-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(20px, 2.2vw, 30px);
    font-weight: 400;
    line-height: 1.15;
  }
  .vl-tile-discover {
    display: inline-flex; align-items: center; gap: 8px;
    margin-top: 0.85rem;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(255,255,255,0.55);
    border-bottom: 1px solid rgba(255,255,255,0.2);
    padding-bottom: 3px;
    transition: color 0.25s, border-color 0.25s, gap 0.25s;
  }
  .vl-tile-discover::after { content: '→'; }
  .vl-tile:hover .vl-tile-discover {
    color: var(--vl-gold);
    border-color: var(--vl-gold);
    gap: 14px;
  }
  /* Placeholder when no image */
  .vl-tile-placeholder {
    width: 100%; height: 100%;
    background: linear-gradient(135deg, #e8e3da 0%, #ddd8ce 100%);
    display: flex; align-items: center; justify-content: center;
  }
  .vl-tile-placeholder span {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    color: rgba(26,22,18,0.2);
  }

  /* ── SHOP BY CATEGORY ─────────────────────────────────── */
  .vl-cats { background: var(--vl-bg); padding: 6rem 6vw 5rem; }
  .vl-cats-head { text-align: center; margin-bottom: 3.5rem; }
  .vl-cats-eyebrow {
    font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--vl-gold); margin-bottom: 1rem;
  }
  .vl-cats-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 44px); font-weight: 400; color: var(--vl-ink);
  }
  .vl-cats-grid {
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem; max-width: 720px; margin: 0 auto;
  }
  .vl-cat { text-align: center; display: block; }
  .vl-cat-tile {
    position: relative; aspect-ratio: 1 / 1; border-radius: 14px;
    overflow: hidden; display: flex; align-items: center; justify-content: center;
  }
  .vl-cat-tile::after {
    content: ''; position: absolute; inset: 0; border-radius: 14px;
    box-shadow: inset 0 0 0 1px rgba(200, 169, 110, 0.4);
    pointer-events: none;
  }
  .vl-cat-img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s cubic-bezier(0.25, 0.46, 0.45, 0.94); }
  .vl-cat:hover .vl-cat-img { transform: scale(1.06); }
  .vl-cat-ph { display: flex; align-items: center; justify-content: center; }
  .vl-cat-ph svg { width: 64px; height: 64px; opacity: 0.55; transition: transform 0.6s ease; }
  .vl-cat:hover .vl-cat-ph svg { transform: scale(1.1) rotate(2deg); }
  .vl-cat-label {
    margin-top: 1.1rem; font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(15px, 1.4vw, 18px); color: var(--vl-ink);
  }
  @media (max-width: 900px) {
    .vl-cats-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .vl-cats { padding: 4rem 6vw 3.5rem; }
  }

  /* ── STATEMENT ────────────────────────────────────────── */
  .vl-statement {
    padding: clamp(4rem, 11vw, 10rem) 6vw;
    background: var(--vl-bg-alt);
    border-top: 1px solid var(--vl-rule);
    border-bottom: 1px solid var(--vl-rule);
  }
  .vl-statement-inner {
    max-width: 800px; margin: 0 auto; text-align: center;
  }
  .vl-statement-rule {
    width: 40px; height: 1px;
    background: var(--vl-gold);
    margin: 0 auto 3rem;
  }
  .vl-statement-q {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(24px, 4vw, 52px);
    font-weight: 400; font-style: italic;
    line-height: 1.25; color: var(--vl-ink);
  }
  .vl-statement-attr {
    margin-top: 2rem;
    font-size: 10px; letter-spacing: 0.26em; text-transform: uppercase;
    color: var(--vl-gold);
  }

  /* ── EDITORIAL SPLIT ──────────────────────────────────── */
  .vl-editorial {
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 80vh;
  }
  .vl-editorial.cream { background: var(--vl-bg);     color: var(--vl-ink); }
  .vl-editorial.dark  { background: var(--vl-bg-alt); color: var(--vl-ink); }
  .vl-editorial.rev   { direction: rtl; }
  .vl-editorial.rev > * { direction: ltr; }

  .vl-editorial-vis {
    position: relative; overflow: hidden;
  }
  .vl-editorial-vis img,
  .vl-editorial-vis video {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .vl-editorial-vis:hover img,
  .vl-editorial-vis:hover video { transform: scale(1.04); }

  .vl-editorial-txt {
    padding: 8vw 6vw;
    display: flex; flex-direction: column; justify-content: center;
  }
  .cream .vl-editorial-txt { border-left: 1px solid var(--vl-rule); }
  .dark  .vl-editorial-txt { border-left: 1px solid var(--vl-rule); }
  .rev.cream .vl-editorial-txt { border-left: none; border-right: 1px solid var(--vl-rule); }
  .rev.dark  .vl-editorial-txt { border-left: none; border-right: 1px solid var(--vl-rule); }

  .vl-ed-eyebrow {
    font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase;
    margin-bottom: 2.5rem;
    display: flex; align-items: center; gap: 14px;
  }
  .cream .vl-ed-eyebrow { color: var(--vl-gold); }
  .dark  .vl-ed-eyebrow { color: var(--vl-gold); }
  .vl-ed-eyebrow::before {
    content: ''; display: block; flex-shrink: 0;
    width: 28px; height: 1px; background: var(--vl-gold);
  }

  .vl-ed-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(32px, 3.8vw, 52px);
    font-weight: 400; line-height: 1.08;
    margin-bottom: 1.75rem;
  }
  .vl-ed-title em { font-style: italic; color: #5a4a38; }

  .vl-ed-body {
    font-size: 14px; line-height: 1.85; max-width: 380px;
    margin-bottom: 3rem;
    color: var(--vl-mid);
  }

  .vl-ed-link {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--vl-ink);
    border-bottom: 1px solid rgba(26,22,18,0.3);
    padding-bottom: 4px;
    transition: gap 0.25s;
    align-self: flex-start;
  }
  .vl-ed-link::after { content: '→'; }
  .vl-ed-link:hover { gap: 20px; }

  /* ── FULL-BLEED FEATURE ──────────────────────────────── */
  .vl-feature {
    position: relative;
    min-height: 70vh;
    display: flex; align-items: center; justify-content: center;
    overflow: hidden;
  }
  .vl-feature-bg {
    position: absolute; inset: 0;
    width: 100%; height: 100%; object-fit: cover;
  }
  .vl-feature-ov {
    position: absolute; inset: 0;
    background: rgba(8,8,8,0.62);
  }
  .vl-feature-content {
    position: relative; z-index: 1;
    text-align: center; padding: 6rem 6vw;
    max-width: 680px;
  }
  .vl-feature-eyebrow {
    font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase;
    color: var(--vl-gold); margin-bottom: 2rem;
  }
  .vl-feature-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 4.5vw, 58px);
    font-weight: 400; font-style: italic;
    line-height: 1.22; color: #faf9f6;
  }
  .vl-feature-rule {
    width: 40px; height: 1px;
    background: var(--vl-gold);
    margin: 2.5rem auto;
  }
  .vl-feature-cta {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase;
    color: #faf9f6;
    border-bottom: 1px solid rgba(245,240,232,0.4);
    padding-bottom: 4px;
    transition: border-color 0.25s, gap 0.25s;
  }
  .vl-feature-cta::after { content: '→'; }
  .vl-feature-cta:hover { border-color: var(--vl-gold); gap: 18px; }

  /* ── FEATURED PRODUCTS ────────────────────────────────── */
  .vl-products {
    background: var(--vl-bg);
    padding: 8rem 6vw;
    border-top: 1px solid var(--vl-rule);
  }
  .vl-products-header {
    display: flex; align-items: flex-end; justify-content: space-between;
    margin-bottom: 4rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--vl-rule);
  }
  .vl-products-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(28px, 3.5vw, 44px);
    font-weight: 400; color: #1a1612;
    line-height: 1.1;
  }
  .vl-products-title em { font-style: italic; }
  .vl-products-viewall {
    display: inline-flex; align-items: center; gap: 10px;
    font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
    color: #1a1612;
    border-bottom: 1px solid rgba(26,22,18,0.25);
    padding-bottom: 3px;
    white-space: nowrap;
    transition: gap 0.25s;
  }
  .vl-products-viewall::after { content: '→'; }
  .vl-products-viewall:hover { gap: 18px; }

  .vl-product-grid {
    display: flex;
    gap: 2px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }
  .vl-product-grid::-webkit-scrollbar { display: none; }
  .vl-product-grid .vl-product-card {
    flex: 0 0 clamp(240px, 23vw, 340px);
    scroll-snap-align: start;
  }
  @media screen and (max-width: 749px) {
    .vl-product-grid .vl-product-card { flex-basis: 72vw; }
  }
  .vl-product-card {
    background: #fff;
    cursor: pointer;
  }
  .vl-product-card a { display: block; }
  .vl-product-img-wrap {
    position: relative; overflow: hidden;
    aspect-ratio: 3/4;
    background: #f0ece5;
  }
  .vl-product-img {
    width: 100%; height: 100%;
    object-fit: cover;
    transition: transform 1s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .vl-product-card:hover .vl-product-img { transform: scale(1.07); }
  .vl-product-info {
    padding: 1.25rem 1rem 1.5rem;
  }
  .vl-product-collection {
    font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--vl-gold); margin-bottom: 0.35rem;
  }
  .vl-product-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 15px; font-weight: 400;
    color: #1a1612; line-height: 1.3;
    margin-bottom: 0.4rem;
  }
  .vl-product-price {
    font-size: 13px; color: rgba(26,22,18,0.55);
  }
  /* Empty product placeholder */
  .vl-product-placeholder {
    background: linear-gradient(135deg, #e8e3db, #ddd8ce);
    display: flex; align-items: center; justify-content: center;
  }
  .vl-product-placeholder span {
    font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(26,22,18,0.2);
  }

  /* ── ENQUIRE STRIP ────────────────────────────────────── */
  .vl-enquire {
    display: grid; grid-template-columns: 1fr 1fr;
    min-height: 70vh;
    background: var(--vl-bg-alt);
    border-top: 1px solid var(--vl-rule);
  }
  .vl-enquire-vis {
    position: relative; overflow: hidden;
    border-right: 1px solid var(--vl-rule);
  }
  .vl-enquire-vis img,
  .vl-enquire-vis video {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 1.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
  }
  .vl-enquire-vis:hover img,
  .vl-enquire-vis:hover video { transform: scale(1.04); }
  .vl-enquire-vis-ov {
    position: absolute; inset: 0;
    background: linear-gradient(to top, rgba(8,8,8,0.7) 0%, transparent 60%);
  }
  .vl-enquire-vis-caption {
    position: absolute; bottom: 2.5rem; left: 2.5rem;
  }
  .vl-enquire-vis-caption strong {
    display: block;
    font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--vl-gold); margin-bottom: 0.5rem; font-weight: 400;
  }
  .vl-enquire-vis-caption p {
    font-family: 'Playfair Display', Georgia, serif;
    font-style: italic; font-size: 18px;
    color: rgba(245,240,232,0.82); line-height: 1.4;
  }

  .vl-enquire-form {
    padding: 7rem 6vw;
    display: flex; flex-direction: column; justify-content: center;
  }
  .vl-enquire-eyebrow {
    font-size: 10px; letter-spacing: 0.28em; text-transform: uppercase;
    color: var(--vl-gold); margin-bottom: 1rem;
  }
  .vl-enquire-title {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 400; line-height: 1.1;
    margin-bottom: 0.8rem; color: var(--vl-ink);
  }
  .vl-enquire-sub {
    font-size: 13px; line-height: 1.85;
    color: var(--vl-mid);
    max-width: 360px; margin-bottom: 2.5rem;
  }
  .vl .vl-enquire-wa {
    display: inline-flex; align-items: center; gap: 12px; align-self: flex-start;
    background: var(--vl-ink); color: #faf9f6;
    padding: 16px 34px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase;
    border: 1px solid var(--vl-ink);
    transition: background 0.25s, color 0.25s;
  }
  .vl .vl-enquire-wa:hover { background: transparent; color: var(--vl-ink); }
  .vl .vl-enquire-wa svg { width: 18px; height: 18px; flex-shrink: 0; }
  .vl-enquire-alt {
    margin-top: 1.5rem; font-size: 12px; color: var(--vl-faint); letter-spacing: 0.02em;
  }
  .vl-enquire-alt a { color: var(--vl-ink); border-bottom: 1px solid rgba(26,22,18,0.25); padding-bottom: 1px; }
  .vl-form { display: flex; flex-direction: column; gap: 1.25rem; }
  .vl-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
  .vl-form-g { display: flex; flex-direction: column; gap: 6px; }
  .vl-form-g label {
    font-size: 9px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--vl-faint);
  }
  .vl-form-g input,
  .vl-form-g select,
  .vl-form-g textarea {
    background: transparent; border: none;
    border-bottom: 1px solid rgba(26,22,18,0.18);
    padding: 10px 0;
    font-size: 14px; font-family: inherit;
    color: var(--vl-ink);
    width: 100%; outline: none;
    -webkit-appearance: none; border-radius: 0;
    transition: border-color 0.25s;
  }
  .vl-form-g select option { background: #faf9f6; color: #1a1612; }
  .vl-form-g textarea { resize: none; min-height: 64px; }
  .vl-form-g input:focus,
