{% comment %} VELONNA — Social proof: trust strip + editorial testimonials {% endcomment %}

<style>
  .vl-social {
    background: #faf9f6;
    color: #1a1612;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif;
    font-weight: 300;
    padding: 72px 6vw 88px;
  }
  .vl-social__trust {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    padding-bottom: 56px;
    margin-bottom: 64px;
    border-bottom: 1px solid rgba(26, 22, 18, 0.1);
    text-align: center;
  }
  .vl-social__trust-item p {
    margin: 0;
  }
  .vl-social__trust-num {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px;
    color: #c8a96e;
    margin-bottom: 6px !important;
  }
  .vl-social__trust-label {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(26, 22, 18, 0.55);
  }
  .vl-social__heading {
    font-family: 'Playfair Display', Georgia, serif;
    font-weight: 400;
    font-size: clamp(28px, 4vw, 44px);
    text-align: center;
    margin: 0 0 48px;
  }
  .vl-social__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 40px;
    max-width: 1200px;
    margin: 0 auto;
  }
  .vl-social__card {
    border-top: 1px solid #c8a96e;
    padding-top: 28px;
  }
  .vl-social__stars {
    color: #c8a96e;
    font-size: 14px;
    letter-spacing: 4px;
    margin: 0 0 16px;
  }
  .vl-social__quote {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 17px;
    line-height: 1.6;
    font-style: italic;
    margin: 0 0 20px;
  }
  .vl-social__author {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(26, 22, 18, 0.55);
    margin: 0;
  }
  @media screen and (max-width: 899px) {
    .vl-social__trust { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
    .vl-social__grid {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      margin: 0 -6vw;
      padding: 0 6vw 8px;
    }
    .vl-social__grid::-webkit-scrollbar { display: none; }
    .vl-social__card {
      flex: 0 0 78vw;
      scroll-snap-align: center;
    }
  }
</style>

<section class="vl-social">
  <div class="vl-social__trust">
    {%- for i in (1..4) -%}
      {%- assign num_key = 'trust' | append: i | append: '_num' -%}
      {%- assign label_key = 'trust' | append: i | append: '_label' -%}
      {%- if section.settings[num_key] != blank -%}
        <div class="vl-social__trust-item">
          <p class="vl-social__trust-num">{{ section.settings[num_key] }}</p>
          <p class="vl-social__trust-label">{{ section.settings[label_key] }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.heading != blank -%}
    <h2 class="vl-social__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="vl-social__grid">
    {%- for block in section.blocks -%}
      <div class="vl-social__card" {{ block.shopify_attributes }}>
        <p class="vl-social__stars" aria-label="5 star review">&#9733;&#9733;&#9733;&#9733;&#9733;</p>
        <p class="vl-social__quote">&ldquo;{{ block.settings.quote }}&rdquo;</p>
        <p class="vl-social__author">{{ block.settings.author }}</p>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Velonna Social Proof",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "trust1_num", "label": "Stat 1", "default": "925" },
    { "type": "text", "id": "trust1_label", "label": "Label 1", "default": "Certified Sterling Silver" },
    { "type": "text", "id": "trust2_num", "label": "Stat 2", "default": "IGI" },
    { "type": "text", "id": "trust2_label", "label": "Label 2", "default": "Certified Created Diamonds" },
    { "type": "text", "id": "trust3_num", "label": "Stat 3", "default": "15-Day" },
    { "type": "text", "id": "trust3_label", "label": "Label 3", "default": "No-Questions Returns" },
    { "type": "text", "id": "trust4_num", "label": "Stat 4", "default": "Free" },
    { "type": "text", "id": "trust4_label", "label": "Label 4", "default": "Insured Shipping" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The craftsmanship is stunning — looks far more expensive than it is." },
        { "type": "text", "id": "author", "label": "Author", "default": "Verified Buyer · Mumbai" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Velonna Social Proof",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
