{% comment %} VELONNA — Social proof: trust strip + auto-scrolling Polaroid wall {% endcomment %}

<style>
  .vl-social {
    background: #faf9f6; color: #1a1612;
    font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; font-weight: 300;
    padding: 72px 6vw 88px;
  }
  .vl-social__trust {
    display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px;
    padding-bottom: 56px; margin-bottom: 64px;
    border-bottom: 1px solid rgba(26, 22, 18, 0.1); text-align: center;
  }
  .vl-social__trust-item p { margin: 0; }
  .vl-social__trust-num {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 26px; color: #c8a96e; margin-bottom: 6px !important;
  }
  .vl-social__trust-label {
    font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(26, 22, 18, 0.55);
  }
  .vl-social__heading {
    font-family: 'Playfair Display', Georgia, serif; font-weight: 400;
    font-size: clamp(28px, 4vw, 44px); text-align: center; margin: 0 0 8px;
  }
  .vl-social__sub {
    text-align: center; font-size: 11px; letter-spacing: 0.24em;
    text-transform: uppercase; color: #c8a96e; margin: 0 0 40px;
  }

  /* Auto-scrolling polaroid marquee */
  .vl-polaroids { overflow: hidden; padding: 24px 0 34px; }
  .vl-polaroids-track {
    display: flex; width: max-content;
    animation: vlPolaroidScroll 70s linear infinite;
  }
  .vl-polaroids:hover .vl-polaroids-track { animation-play-state: paused; }
  .vl-polaroids-group { display: flex; gap: 30px; padding-right: 30px; }
  @keyframes vlPolaroidScroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  .vl-polaroid {
    flex: 0 0 auto; width: 250px; background: #fff;
    padding: 14px 14px 44px;
    box-shadow: 0 12px 32px rgba(26, 22, 18, 0.16);
    transform: rotate(var(--rot, 0deg));
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .vl-polaroid:hover { transform: rotate(0deg) translateY(-8px); box-shadow: 0 20px 44px rgba(26, 22, 18, 0.24); }
  .vl-polaroid-photo { width: 100%; aspect-ratio: 4 / 5; overflow: hidden; background: #ece7de; }
  .vl-polaroid-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }

  @media screen and (max-width: 899px) {
    .vl-social__trust { grid-template-columns: repeat(2, 1fr); gap: 32px 16px; }
    .vl-polaroid { width: 62vw; max-width: 260px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .vl-polaroids { overflow-x: auto; }
    .vl-polaroids-track { animation: none; }
  }
</style>

<section class="vl-social">
  <div class="vl-social__trust">
    {%- for i in (1..4) -%}
      {%- assign num_key = 'trust' | append: i | append: '_num' -%}
      {%- assign label_key = 'trust' | append: i | append: '_label' -%}
      {%- if section.settings[num_key] != blank -%}
        <div class="vl-social__trust-item">
          <p class="vl-social__trust-num">{{ section.settings[num_key] }}</p>
          <p class="vl-social__trust-label">{{ section.settings[label_key] }}</p>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>

  {%- if section.settings.heading != blank -%}
    <h2 class="vl-social__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}
  <p class="vl-social__sub">The Velonna family &middot; In person</p>

  {%- capture polaroid_group -%}
    {%- for i in (1..16) -%}
      {%- assign img = 'velonna-review-' | append: i | append: '.jpg' -%}
      <figure class="vl-polaroid" style="--rot: {% cycle 'rot': '-3deg', '2.5deg', '-2deg', '3deg', '-1.5deg', '2deg' %};">
        <div class="vl-polaroid-photo">
          <img src="{{ img | asset_url }}" alt="Velonna customer in store" loading="lazy">
        </div>
      </figure>
    {%- endfor -%}
  {%- endcapture -%}

  <div class="vl-polaroids">
    <div class="vl-polaroids-track">
      <div class="vl-polaroids-group">{{ polaroid_group }}</div>
      <div class="vl-polaroids-group" aria-hidden="true">{{ polaroid_group }}</div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Velonna Social Proof",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Loved by our customers" },
    { "type": "header", "content": "Trust strip" },
    { "type": "text", "id": "trust1_num", "label": "Stat 1", "default": "925" },
    { "type": "text", "id": "trust1_label", "label": "Label 1", "default": "Certified Sterling Silver" },
    { "type": "text", "id": "trust2_num", "label": "Stat 2", "default": "IGI" },
    { "type": "text", "id": "trust2_label", "label": "Label 2", "default": "Certified Lab Grown Diamonds" },
    { "type": "text", "id": "trust3_num", "label": "Stat 3", "default": "7-Day" },
    { "type": "text", "id": "trust3_label", "label": "Label 3", "default": "Return Window" },
    { "type": "text", "id": "trust4_num", "label": "Stat 4", "default": "Free" },
    { "type": "text", "id": "trust4_label", "label": "Label 4", "default": "Insured Shipping" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial (legacy)",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "author", "label": "Author" }
      ]
    }
  ],
  "presets": [ { "name": "Velonna Social Proof" } ]
}
{% endschema %}
